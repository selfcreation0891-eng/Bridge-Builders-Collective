# ——— Front door (static build) ———
# Canonical public origin, e.g. https://www.example.org — used only to generate
# sitemap.xml and robots.txt. If unset, the XML sitemap is skipped (domains are
# never invented). Historical name: NEXT_PUBLIC_APP_URL (renamed; conflict C-003).
PUBLIC_APP_URL=

# ——— Backend (Supabase) — reserved for future downstream environments; not used by the front door ———
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication (future)
AUTH_SECRET=

# Storage (future)
STORAGE_BUCKET=

# Analytics (future; any adoption requires the privacy decision recorded in
# docs/FRONT_DOOR_RELEASE_CHECKLIST.md — the v0.1.0 front door ships with NO analytics)
H_ROI_ANALYTICS_KEY=

# Environment
NODE_ENV=development
